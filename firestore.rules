rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // 1. Users
    // Anyone can read a user profile. Only the owner can create/update.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if false; // Soft deletes preferred
    }

    // 2. Businesses
    // Anyone can read a business profile. Only the owner can create/update.
    // Supports random document IDs where ownerId matches auth.uid.
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    // 3. Jobs
    // Anyone can read jobs. Only authenticated users can create. Only the owner can update.
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.businessId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.businessId == request.auth.uid;
    }

    // 4. Applications
    // Students can read their own applications. Businesses can read applications for their jobs.
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || 
        resource.data.businessId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.businessId == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.studentId == request.auth.uid;
    }

    // 5. Conversations & Subcollection Messages (Option A)
    // Users can read/write conversations they are participants in.
    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      allow delete: if false;
      
      // Messages are nested under conversations for clean scoping, data privacy and real-time streams
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated() && 
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == "system");
        allow update, delete: if false;
      }
    }

    // 6. Workflows (Execution System)
    // Access restricted to participants of the workflow (business and student).
    match /workflows/{workflowId} {
      allow read, update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || request.resource.data.businessId == request.auth.uid);
      allow delete: if false;
    }

    match /workflowColumns/{columnId} {
      allow read, update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || request.resource.data.businessId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
    }

    match /workflowTasks/{taskId} {
      allow read, update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || request.resource.data.businessId == request.auth.uid);
      allow delete: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
    }

    match /workflowActivity/{activityId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || request.resource.data.businessId == request.auth.uid);
      allow update, delete: if false; // Activity logs are immutable
    }

    // 7. Notifications
    // Users can only read and manage their own notifications.
    // Any authenticated user can create a notification for another user (e.g. invites or updates).
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // 8. Trust Engine
    // Anyone can read a candidate's trust profile. Only authenticated system actions can write/update.
    match /trustProfiles/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Trust history is only readable by the owner to protect transaction metrics, create is authenticated.
    match /trustHistory/{eventId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 9. Portfolios
    // Anyone can read portfolio items. Only the owner student can write/delete.
    match /portfolios/{portfolioId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 10. Escrows
    // Access restricted entirely to student and business participants.
    match /escrows/{escrowId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.studentId == request.auth.uid || request.resource.data.businessId == request.auth.uid);
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow delete: if false;
    }

    // 11. Gig Invitations
    // Only business owners can create invitations. Only invited students or businesses can read/update.
    match /gigInvitations/{invitationId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.businessId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || resource.data.businessId == request.auth.uid);
      allow delete: if false;
    }

    // 12. Reviews (Secure Reputation Validation)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
        // 1. Reviewer matches authenticated user
        request.resource.data.reviewerId == request.auth.uid &&
        // 2. Reviewer is a participant of the workflow
        (request.auth.uid == get(/databases/$(database)/documents/workflows/$(request.resource.data.workflowId)).data.studentId ||
         request.auth.uid == get(/databases/$(database)/documents/workflows/$(request.resource.data.workflowId)).data.businessId) &&
        // 3. Prevent self-reviews
        request.resource.data.reviewerId != request.resource.data.revieweeId &&
        // 4. Reviewee is a participant of the workflow
        (request.resource.data.revieweeId == get(/databases/$(database)/documents/workflows/$(request.resource.data.workflowId)).data.studentId ||
         request.resource.data.revieweeId == get(/databases/$(database)/documents/workflows/$(request.resource.data.workflowId)).data.businessId) &&
        // 5. Escrow must be released
        get(/databases/$(database)/documents/escrows/$(request.resource.data.escrowId)).data.status == "released" &&
        // 6. Review ID must match format to prevent duplicates
        reviewId == "rev_" + request.resource.data.reviewerId + "_" + request.resource.data.workflowId;
      allow update, delete: if false;
    }

    // 13. Verification Submissions (Secure Placeholders)
    match /verificationSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // 14. Analytics Snapshots (Secure Placeholders)
    match /analyticsSnapshots/{snapshotId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }
  }
}
